# Core
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (inside docker-compose, host is `db`; from Windows host use localhost:5433)
DATABASE_URL=postgresql+psycopg://billchecker:billchecker@localhost:5433/billchecker

# Redis / future Celery
REDIS_URL=redis://localhost:6379/0

# Object storage: "minio" or "fs" (filesystem fallback for local dev)
STORAGE_BACKEND=minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bill-checker
# Filesystem fallback dir (when STORAGE_BACKEND=fs)
LOCAL_STORAGE_DIR=./data/uploads

# AI providers
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# groq = real OCR (needs key) | fixture = offline canned receipt
OCR_BACKEND=fixture

# CORS
FRONTEND_ORIGIN=http://localhost:3000
